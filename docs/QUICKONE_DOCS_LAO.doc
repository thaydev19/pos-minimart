          </div>

          <!-- Product Grid Mockup -->
          <table style="width: 100%; border-collapse: separate; border-spacing: 8px;">
            <tr>
              <td style="background: white; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px; width: 33%; text-align: center;">
                <div style="background: #e2e8f0; height: 70px; border-radius: 4px; line-height: 70px; color: #64748b;">[ ຮູບສິນຄ້າ ]</div>
                <div style="font-weight: bold; margin-top: 6px; font-size: 10pt;">ຊາຂຽວ ໂອອິຊິ 500ml</div>
                <div style="color: #059669; font-weight: bold;">12.000 ₭</div>
                <div style="font-size: 8pt; color: #64748b;">ບາໂຄດ: 8854698005050</div>
              </td>
              <td style="background: white; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px; width: 33%; text-align: center;">
                <div style="background: #e2e8f0; height: 70px; border-radius: 4px; line-height: 70px; color: #64748b;">[ ຮູບສິນຄ້າ ]</div>
                <div style="font-weight: bold; margin-top: 6px; font-size: 10pt;">ເບຍລາວ ຂວດໃຫຍ່ 640ml</div>
                <div style="color: #059669; font-weight: bold;">15.000 ₭</div>
                <div style="font-size: 8pt; color: #64748b;">ບາໂຄດ: 8850029010212</div>
              </td>
              <td style="background: white; border: 1px solid #cbd5e1; border-radius: 8px; padding: 10px; width: 33%; text-align: center;">
                <div style="background: #e2e8f0; height: 70px; border-radius: 4px; line-height: 70px; color: #64748b;">[ ຮູບສິນຄ້າ ]</div>
                <div style="font-weight: bold; margin-top: 6px; font-size: 10pt;">ນ້ຳດື່ມ ຫົວເສືອ 600ml</div>
