{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "lao-minimart-pos",
  "version": "0.1.0",
  "identifier": "com.laominimart.pos",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ມິນິມາດ ລາວຈະເລີນ - Lao Minimart POS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "visible": false,
        "backgroundColor": "#F8FAFC"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3NzZDODREMkMyQTY1QzAKUldUQVpTb3NUY2gyUjNsNytmeVpXd3MzdjVacnI2RnQ1MUMxUGZtWHUzMWE5TzM2YXl3WUJ3TVIK",
      "endpoints": [
        "https://github.com/thaydev19/pos-minimart/releases/latest/download/latest.json"
      ]
    }
  }
}
